# NetVision Environment Variables
# Copy this file to .env and adjust values as needed.

# Application
APP_TITLE="NetVision"
DEBUG=false

# Database
# SQLite database path (default is local netvision.db)
DATABASE_URL="sqlite:///./netvision.db"
MAX_PACKETS_STORED=50000

# Capture Settings
PACKET_RING_BUFFER_SIZE=2000

# Detection Thresholds
PORT_SCAN_THRESHOLD=15
PORT_SCAN_WINDOW_S=5.0
SYN_FLOOD_SYN_THRESHOLD=200
SYN_FLOOD_INCOMPLETE_RATIO=0.80
SYN_FLOOD_WINDOW_S=10.0
TRAFFIC_SPIKE_MULTIPLIER=3.0
TRAFFIC_SPIKE_MIN_BASELINE=10000.0

# Stats Engine Settings
STATS_ROLLING_WINDOW_S=10.0
STATS_SNAPSHOT_INTERVAL_S=1.0

# Health Score Configuration
INTERFACE_CAPACITY_MBPS=100.0
