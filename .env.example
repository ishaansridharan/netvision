# NetVision environment variables
# Copy this file to .env (in the directory you start the server from) and
# uncomment what you want to change.  Every field in backend/config.py can be
# set this way, upper-cased.

# ── Application ───────────────────────────────────────────────────────────
# DEBUG=false

# ── Storage ───────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./netvision.db
# PERSIST_PACKETS=false          # alerts, flows and 1 s stats are always stored
# MAX_PACKETS_STORED=50000

# ── Capture ───────────────────────────────────────────────────────────────
# PACKET_RING_BUFFER_SIZE=2000
# CAPTURE_QUEUE_SIZE=20000       # full queue → packets dropped and counted
# CAPTURES_DIR=captures          # where /capture/replay looks for .pcap files
# LOCAL_NETWORKS=192.168.1.0/24  # override "local" for upload/download split
# INTERFACE_CAPACITY_MBPS=100

# ── Detection mode ────────────────────────────────────────────────────────
# DETECTION_MODE=adaptive        # or static (switchable at runtime too)
# BASELINE_ALPHA=0.05            # EWMA smoothing per 1 s sample
# BASELINE_Z_THRESHOLD=3.0       # alert above μ + kσ
# BASELINE_WARMUP_SAMPLES=30

# ── Port scan ─────────────────────────────────────────────────────────────
# PORT_SCAN_WINDOW_S=5.0
# PORT_SCAN_THRESHOLD=15         # static: distinct ports per source
# PORT_SCAN_ADAPTIVE_FLOOR=8     # adaptive never goes below this

# ── SYN flood ─────────────────────────────────────────────────────────────
# SYN_FLOOD_WINDOW_S=10.0
# SYN_FLOOD_SYN_THRESHOLD=200    # static: SYNs in window
# SYN_FLOOD_INCOMPLETE_RATIO=0.80
# SYN_FLOOD_ADAPTIVE_FLOOR_RATE=20
# SYN_FLOOD_ADAPTIVE_MIN_RATIO=0.5

# ── ARP ───────────────────────────────────────────────────────────────────
# ARP_CONFLICT_WINDOW_S=120      # adaptive: old MAC active this recently = conflict

# ── Traffic spike ─────────────────────────────────────────────────────────
# TRAFFIC_SPIKE_STATIC_BPS=1250000   # static: bytes/s (10 Mbit/s)
# TRAFFIC_SPIKE_MULTIPLIER=3.0       # adaptive: also ≥ 3 × baseline mean
# TRAFFIC_SPIKE_MIN_BPS=125000       # adaptive: never below 1 Mbit/s
# TRAFFIC_SPIKE_MIN_DURATION_S=2

# ── Stats ─────────────────────────────────────────────────────────────────
# STATS_ROLLING_WINDOW_S=10.0
# STATS_SNAPSHOT_INTERVAL_S=1.0
# LATENCY_WINDOW_S=30.0
